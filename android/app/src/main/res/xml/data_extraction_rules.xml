<?xml version="1.0" encoding="utf-8"?>
<!-- The device key and pairings never leave the phone: no cloud backup, no transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
